<?xml version="1.0" encoding="UTF-8"?>
<!-- OWNER: Ismail. fx:id / onAction names must match ExportViewController exactly. -->
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.blms.ui.controller.ExportViewController" spacing="16">
    <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

    <VBox spacing="4">
        <Label text="Export Outreach Data" styleClass="title"/>
        <Label text="Export lead and pipeline interaction records to CSV (UC12)" styleClass="subtitle"/>
    </VBox>

    <VBox styleClass="card" spacing="14" maxWidth="480">
        <Label text="Export Filter" styleClass="section-header"/>
        <Label text="Choose the segment of leads you wish to export:" styleClass="hint"/>
        <ComboBox fx:id="criteriaCombo" maxWidth="Infinity"/>

        <HBox spacing="10">
            <Button text="Export to CSV..." onAction="#onExport" styleClass="primary-button"/>
        </HBox>
    </VBox>
</VBox>
