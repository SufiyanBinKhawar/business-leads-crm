<?xml version="1.0" encoding="UTF-8"?>
<!-- OWNER: Ismail. fx:id / onAction names must match the view controller exactly. -->
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.blms.ui.controller.DashboardViewController" spacing="20">
    <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

    <VBox spacing="4">
        <Label text="Pipeline Dashboard" styleClass="title"/>
        <Label text="High-level overview of lead stages and discovery status" styleClass="subtitle"/>
    </VBox>

    <FlowPane fx:id="metricsPane" hgap="16" vgap="16"/>

    <VBox styleClass="card" spacing="12">
        <Label text="Discovery &amp; Actions" styleClass="section-header"/>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Button fx:id="runDiscoveryButton" text="Run API Discovery" onAction="#onRunApiDiscovery" styleClass="primary-button"/>
            <ProgressIndicator fx:id="discoveryProgress" visible="false" prefWidth="24" prefHeight="24"/>
            <Button text="Export Data" onAction="#onExportData"/>
        </HBox>
    </VBox>
</VBox>
