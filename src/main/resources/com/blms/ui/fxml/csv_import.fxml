<?xml version="1.0" encoding="UTF-8"?>
<!-- OWNER: Ismail. fx:id / onAction names must match the view controller exactly. -->
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.blms.ui.controller.CsvImportViewController" spacing="12" prefWidth="520">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Button text="Choose CSV File" onAction="#onChooseFile"/>
        <Label fx:id="fileLabel" text="No file selected"/>
    </HBox>
    <GridPane fx:id="mappingGrid" hgap="8" vgap="8"/>
    <ProgressBar fx:id="importProgress" visible="false" maxWidth="Infinity"/>
    <Button fx:id="importButton" text="Import" onAction="#onImport" styleClass="primary"/>
</VBox>
