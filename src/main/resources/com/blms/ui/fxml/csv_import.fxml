<?xml version="1.0" encoding="UTF-8"?>
<!-- OWNER: Ismail. fx:id / onAction names must match CsvImportViewController exactly. -->
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.blms.ui.controller.CsvImportViewController" spacing="16">
    <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

    <VBox spacing="4">
        <Label text="Import Leads from CSV" styleClass="title"/>
        <Label text="Bulk import prospects into the CRM pipeline with column mapping (UC04)" styleClass="subtitle"/>
    </VBox>

    <VBox styleClass="card" spacing="14" maxWidth="640">
        <Label text="Select Data File" styleClass="section-header"/>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Button text="Choose CSV File..." onAction="#onChooseFile"/>
            <Label fx:id="fileLabel" text="No file selected" styleClass="hint"/>
        </HBox>

        <Separator/>

        <Label text="Column Mapping" styleClass="section-header"/>
        <Label text="Map CSV column headers to the corresponding lead fields:" styleClass="hint"/>
        <GridPane fx:id="mappingGrid" hgap="12" vgap="10"/>

        <ProgressBar fx:id="importProgress" visible="false" maxWidth="Infinity"/>

        <HBox spacing="10">
            <Button fx:id="importButton" text="Start Import" onAction="#onImport" styleClass="primary-button"/>
        </HBox>
    </VBox>
</VBox>
